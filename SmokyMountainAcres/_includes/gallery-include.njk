

<!-- Portfolio Section -->
<section id="portfolio" class="portfolio section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>Our Farm</h2>
    <p>A look at the animals, places, and everyday life around Smoky Mountain Acres.</p>
  </div><!-- End Section Title -->

  <div class="container">

    <div
      class="isotope-layout"
      data-default-filter="*"
      data-layout="masonry"
      data-sort="original-order"
    >

      <ul
        class="portfolio-filters isotope-filters"
        data-aos="fade-up"
        data-aos-delay="100"
      >
        <li data-filter="*" class="filter-active">All</li>
        <li data-filter=".filter-pigs">Kune Kune</li>
        <li data-filter=".filter-other">Other</li>
        <li data-filter=".filter-chickens">Chickens</li>
        <li data-filter=".filter-farm-life">Farm Life</li>
      </ul><!-- End Portfolio Filters -->

      <div
        class="row gy-4 isotope-container"
        data-aos="fade-up"
        data-aos-delay="200"
      >

        {% for photo in gallery %}

          <div
            class="col-lg-4 col-md-6 portfolio-item isotope-item filter-{{ photo.category }}"
          >

            <img
              src="{{ photo.image }}"
              class="img-fluid"
              alt="{{ photo.title }}"
            >

            <div class="portfolio-info">

              <h4>{{ photo.title }}</h4>

              <p>{{ photo.description }}</p>

              <a
                href="{{ photo.image }}"
                title="{{ photo.title }}"
                data-gallery="portfolio-gallery-{{ photo.category }}"
                class="glightbox preview-link"
              >
                <i class="bi bi-zoom-in"></i>
              </a>

            </div>

          </div><!-- End Portfolio Item -->

        {% endfor %}

      </div><!-- End Portfolio Container -->

    </div>

  </div>

</section><!-- /Portfolio Section -->