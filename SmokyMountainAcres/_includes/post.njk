---
layout: 'base.njk'
---



  <!-- Page Title -->
    <div class="page-title dark-background">
      <div class="container">
        <h1>{{ title }}</h1>
        <nav class="breadcrumbs">
          <ol>
            <li><a href="index.html">Home</a></li>
            <li class="current">Blog Post</li>
          </ol>
        </nav>
      </div>
    </div><!-- End Page Title -->

    <div class="container">
      <div class="row">

        <div class="col-lg-12">

          <!-- Blog Details Section -->
          <section id="blog-details" class="blog-details section">
            <div class="container">

              <article class="article">

                {% if images %}
                  <div class="post-img">
                    <img src="{{ images[0].src }}" alt="{{ images[0].alt }}" class="img-fluid">
                  </div>
                {% else %}
                  <div class="post-img">
                    <img src="{{ image }}" alt="{{ title }}" class="img-fluid">
                  </div>
                {% endif %}

                <h2 class="title">{{ title }}</h2>

                <div class="meta-top">
                  <ul>
                    <li class="d-flex align-items-center"><i class="bi bi-person"></i>{{ author }}</li>
                    <li class="d-flex align-items-center"><i class="bi bi-clock"></i>
                      <time datetime="{{ page.date.toISOString() }}">{{ date | postDate }}
                    </li>
                  </ul>
                </div><!-- End meta top -->

                <div class="content">
                  {{ content | interleavePostImages(images) | safe }}

                </div><!-- End post content -->

                <div class="meta-bottom">
                  <i class="bi bi-folder"></i>
                  <ul class="cats">
                    <li>{{ category }}</li>
                  </ul>

                  <i class="bi bi-tags"></i>
                    <ul class="tags">
                      {% for tag in tags %}
                        {% if tag != "posts" %}
                          <li>{{ tag }}</li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                </div><!-- End meta bottom -->

              </article>

            </div>
          </section><!-- /Blog Details Section -->

        </div>

      </div>
    </div>

  </main>