<!-- Livestock Availability Page -->
<section id="livestock-intro" class="about section paper-texture">
  <div class="container section-title" data-aos="fade-up">
    <div class="section-title-row">
      <img class="text-decoration-left"
        src="/assets/img/Smoky Mountain Acres/text-decoration-half-leaf.webp"
        alt="">
      <h1>Livestock and Farm Products</h1>
      <img class="text-decoration-right"
        src="/assets/img/Smoky Mountain Acres/text-decoration-half-leaf.webp"
        alt="">
    </div>
    <p>Current availability from Smoky Mountain Acres in Cosby, Tennessee.</p>
  </div>

  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row gy-4 align-items-center">
      <div class="col-lg-6">
          <img src="/assets/img/9.11.26/PigShelterFenceAndPigs2.webp"
          class="img-fluid"
          alt="Pig shelter and pasture fencing at Smoky Mountain Acres">
      </div>
      <div class="col-lg-6 content">
        <h2>What Is Available?</h2>
        <p>
          We are a small growing farm, so availability changes with the animals, season, pasture, and what our family is currently raising. This page separates what we can discuss now from items that are sold out or offered only occasionally.
        </p>
        <p>
          We sell whole hogs by reservation. We do not sell packaged meat. We also have a dairy cow and herd-share option for pet milk, along with eggs and occasional chickens when the flock has birds available.
        </p>
        <a href="#request-form" class="cta-btn">Request Availability</a>
      </div>
    </div>
  </div>
</section>

<section id="livestock-list" class="featured-services section">
  <div class="container section-title" data-aos="fade-up">
    <div class="section-title-row">
      <img class="text-decoration-left"
        src="/assets/img/Smoky Mountain Acres/text-decoration-half-leaf.webp"
        alt="">
      <h2>CURRENT OFFERINGS</h2>
      <img class="text-decoration-right"
        src="/assets/img/Smoky Mountain Acres/text-decoration-half-leaf.webp"
        alt="">
    </div>
    <p>Availability is honest, seasonal, and subject to change.</p>
  </div>

  <div class="container">
    <div class="row gy-4">
      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
        <article class="card h-100">
          <img src="/assets/img/9.11.26/DaddyKuneKune.webp"
            class="img-fluid"
            alt="Pasture-raised pig at Smoky Mountain Acres">
          <div class="card-body">
            <p class="post-category">Available by reservation</p>
            <h3>Whole Hogs</h3>
            <div class="card-content">
              <p>
                We offer whole hogs by reservation when animals reach the right stage and an opening is available. This is a whole-animal offering, not packaged cuts or individual retail meat.
              </p>
              <p>
                Our pigs are raised with pasture access and supplemented with organic feed appropriate for their needs. Contact us to ask about breed, timing, size, reservation details, and current availability.
              </p>
              <a href="#request-form" class="offer-link">ASK ABOUT WHOLE HOGS</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
        <article class="card h-100">
          <img src="/assets/img/9.11.26/cuteSpottedPIg.webp"
            class="img-fluid"
            alt="Young pig at Smoky Mountain Acres">
          <div class="card-body">
            <p class="post-category">Currently sold out</p>
            <h3>Pigs for Breeding or Homesteads</h3>
            <div class="card-content">
              <p>
                We are not currently listing individual breeding, homestead, or pet pigs for sale. Future availability will depend on our herd, breeding plans, and the animals ready to leave the farm.
              </p>
              <a href="#request-form" class="offer-link">REQUEST PIG AVAILABILITY</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="300">
        <article class="card h-100">
          <img src="/assets/img/Smoky Mountain Acres/SMAView1.webp"
            class="img-fluid"
            alt="Smoky Mountain Acres farm landscape near Cosby, Tennessee">
          <div class="card-body">
            <p class="post-category">Currently sold out</p>
            <h3>Pet Milk Herd Share</h3>
            <div class="card-content">
              <p>
                Our dairy cow and herd-share option for pet milk are currently sold out. A herd share is not a retail milk purchase, and any future availability will be explained clearly along with the applicable arrangement and pickup details.
              </p>
              <a href="#request-form" class="offer-link">REQUEST HERD-SHARE UPDATES</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="400">
        <article class="card h-100">
          <img src="/assets/img/9.11.26/ChickensInPasture3.webp"
            class="img-fluid"
            alt="Barred Rock chicken at Smoky Mountain Acres">
          <div class="card-body">
            <p class="post-category">Currently sold out</p>
            <h3>Farm-Fresh Eggs</h3>
            <div class="card-content">
              <p>
                Eggs are not currently available. Production changes with daylight, weather, molting, flock size, and season, so we prefer to share availability based on what the hens are actually laying.
              </p>
              <a href="#request-form" class="offer-link">REQUEST EGG UPDATES</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="500">
        <article class="card h-100">
          <img src="/assets/img/9.11.26/ChickensInPasture.webp"
            class="img-fluid"
            alt="Young chicks at Smoky Mountain Acres">
          <div class="card-body">
            <p class="post-category">Currently sold out</p>
            <h3>Occasional Chickens</h3>
            <div class="card-content">
              <p>
                We sometimes have chickens available, but none are currently listed. When birds are available, details may include age, breed, purpose, and whether they are suitable for a laying flock or homestead.
              </p>
              <a href="#request-form" class="offer-link">REQUEST CHICKEN UPDATES</a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="600">
        <article class="card h-100">
          <img src="/assets/img/Smoky Mountain Acres/SMAView2.webp"
            class="img-fluid"
            alt="Pasture and mountain landscape near Smoky Mountain Acres">
          <div class="card-body">
            <p class="post-category">Future availability</p>
            <h3>Sheep and Other Livestock</h3>
            <div class="card-content">
              <p>
                Our sheep and other farm animals are part of the growing farm, but we are not currently listing them for sale. We will add clear information here when animals are ready and an offering is actually available.
              </p>
              <a href="#request-form" class="offer-link">REQUEST LIVESTOCK UPDATES</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<section id="request-form" class="contact section paper-texture">
  <div class="container section-title" data-aos="fade-up">
    <h2>REQUEST A SOLD-OUT ITEM</h2>
    <p>Tell us what you are looking for and we will keep your request with our availability notes.</p>
  </div>

  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <form
          name="livestock-request"
          method="POST"
          action="/thank-you/"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="php-email-form"
        >
          <input type="hidden" name="form-name" value="livestock-request">
          <div hidden>
            <label>Do not fill this out: <input name="bot-field"></label>
          </div>

          <div class="row gy-4">
            <div class="col-md-6">
              <input type="text" name="name" class="form-control" placeholder="Your Name" required>
            </div>
            <div class="col-md-6">
              <input type="email" name="email" class="form-control" placeholder="Your Email" required>
            </div>
            <div class="col-md-12">
              <select class="form-select" name="request" required>
                <option value="" selected disabled>What would you like updates about?</option>
                <option value="Pigs for breeding or homestead">Pigs for breeding or homestead</option>
                <option value="Pet milk herd share">Pet milk herd share</option>
                <option value="Farm-fresh eggs">Farm-fresh eggs</option>
                <option value="Occasional chickens">Occasional chickens</option>
                <option value="Sheep or other livestock">Sheep or other livestock</option>
              </select>
            </div>
            <div class="col-md-12">
              <textarea class="form-control" name="message" rows="6" placeholder="Tell us what you are looking for, your timing, and where you are located." required></textarea>
            </div>
            <div class="col-md-12 text-center">
              <button type="submit">Send Availability Request</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>