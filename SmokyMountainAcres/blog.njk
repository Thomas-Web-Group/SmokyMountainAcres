---
title: Farm Blog
layout: 'base.njk'
permalink: /blog/
---

<main class="main">

  <!-- Page Title -->
  <div class="page-title dark-background">
    <div class="container">
      <h1>Blog</h1>

      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Blog</li>
        </ol>
      </nav>
    </div>
  </div>
  <!-- End Page Title -->


  <!-- Blog Posts Section -->
  <section id="blog-posts" class="blog-posts section">

    <div class="container">

      <div class="row gy-4">

        {% for post in collections.posts | reverse %}

          <div class="col-lg-4">

            <article>

              <div class="post-img">
                <a href="{{ post.url }}">
                  <img
                    src="{{ post.data.image | default('/assets/img/blog/blog-1.jpg') }}"
                    alt="{{ post.data.title }}"
                    class="img-fluid"
                  >
                </a>
              </div>

              {% if post.data.category %}
                <p class="post-category">
                  {{ post.data.category }}
                </p>
              {% endif %}

              <h2 class="title">
                <a href="{{ post.url }}">
                  {{ post.data.title }}
                </a>
              </h2>

              {% if post.data.description %}
                <p>
                  {{ post.data.description }}
                </p>
              {% endif %}

              <div class="d-flex align-items-center">

                <img
                  src="{{ post.data.authorImage | default('/assets/img/Smoky Mountain Acres/SmokyMountainAcresLogo.png') }}"
                  alt="{{ post.data.author | default('Smoky Mountain Acres') }}"
                  class="img-fluid post-author-img flex-shrink-0"
                >

                <div class="post-meta">

                  <p class="post-author">
                    {{ post.data.author | default('Smoky Mountain Acres') }}
                  </p>

                  <p class="post-date">
                    <time>{{ post.date | postDate }}</time>
                  </p>

                </div>

              </div>

            </article>

          </div>
          <!-- End post list item -->

        {% endfor %}

      </div>

    </div>

  </section>
  <!-- /Blog Posts Section -->

